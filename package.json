{
  "name": "dsh-md-live",
  "version": "0.7.0",
  "description": "DSH native right-tab Markdown preview: lists the workspace, live-refreshes on file change, follows the app theme tokens",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node esbuild.config.js",
    "dev": "npm run build:host && npm run build:client",
    "verify:client": "node scripts/verify-client.cjs",
    "verify:host": "node scripts/verify-host.cjs",
    "verify": "npm run verify:host && npm run verify:client",
    "clean": "rimraf lib",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "markdown",
    "live-preview",
    "editor"
  ],
  "author": "Lin Gan",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "dompurify": "^3.0.6",
    "highlight.js": "^11.9.0",
    "marked": "^9.1.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.19.8",
    "jsdom": "^30.1.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
